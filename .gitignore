# === 민감/중간 산출물 (설계서 C.4-4) ===
# 사람 입력 캡처 3종 세트 (쿠키·헤더 포함)
capture/
# 중간 JSON·PDF·사진 등 수집 산출물
data/
*.har
# 데이터 백업/이전용 압축본 (DB·사진 등 민감 — 커밋 금지)
data.zip
data*.zip
data*.7z
data*.tar*

# Power Automate 가져오기 패키지 (재생성 가능)
powerautomate/package/*.zip

# === 환경변수/비밀 (배포용) ===
.env
.env.*
!.env.example
*.local

# === Python ===
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# === OS/편집기 ===
.DS_Store
Thumbs.db
.vscode/

# Node (Tailwind 정적 빌드 도구)
node_modules/

# 디자인 리뷰 스크린샷(개발 산출물·재생성 가능·용량)
screenshots/
# 외부 참고 이미지(경쟁사 법차 캡처·Stitch 디자인 시안 — 3rd-party·용량, 저장소 제외)
image_ex/
dashboard_ex/

